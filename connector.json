          "mailbox": "mailbox",
          "page": "page"
        },
        "body": {}
      },
      "sampleArguments": {
        "page": 1
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://developer.helpscout.com/mailbox-api/endpoints/conversations/list/",
        "https://developer.helpscout.com/mailbox-api/endpoints/conversations/get/"
      ]
    },
    {
      "name": "helpscout_get_conversation",
      "description": "Read one conversation by ID. Merged-conversation redirects are rejected rather than followed.",
      "method": "GET",
      "path": "/conversations/{conversationId}",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "conversationId"
        ],
        "query": {},
        "body": {}
      },
