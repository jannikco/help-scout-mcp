      "method": "GET",
      "path": "/conversations",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "mailbox": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [],
        "additionalProperties": false
      },
