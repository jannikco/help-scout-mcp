{
  "openapi": "3.1.0",
  "info": {
    "title": "Help Scout selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.helpscout.net/v2"
    }
  ],
  "paths": {
    "/conversations": {
      "get": {
        "operationId": "helpscout_list_conversations",
        "summary": "Read one page of active conversations, optionally filtered by mailbox.",
        "parameters": [
          {
            "name": "mailbox",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/conversations/{conversationId}": {
      "get": {
        "operationId": "helpscout_get_conversation",
        "summary": "Read one conversation by ID. Merged-conversation redirects are rejected rather than followed.",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
